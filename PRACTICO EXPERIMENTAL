from flask_wtf import FlaskForm

from wtforms import (
    StringField,
    TextAreaField,
    FloatField,
    IntegerField,
    SelectField,
    SubmitField
)

from wtforms.validators import (
    DataRequired,
    Length,
    NumberRange
)


class ProductoForm(FlaskForm):

    nombre = StringField(
        "Nombre del producto",
        validators=[
            DataRequired(
                message="Ingrese el nombre."
            ),
            Length(
                min=3,
                message="El nombre debe tener al menos 3 caracteres."
            )
        ]
    )

    descripcion = TextAreaField(
        "Descripción",
        validators=[
            DataRequired(
                message="Ingrese una descripción."
            ),
            Length(
                min=10,
                message="La descripción debe tener al menos 10 caracteres."
            )
        ]
    )

    precio = FloatField(
        "Precio",
        validators=[
            DataRequired(
                message="Ingrese el precio."
            ),
            NumberRange(
                min=0,
                message="El precio no puede ser negativo."
            )
        ]
    )

    stock = IntegerField(
        "Stock",
        validators=[
            DataRequired(
                message="Ingrese el stock."
            ),
            NumberRange(
                min=0,
                message="El stock no puede ser negativo."
            )
        ]
    )

    categoria_id = SelectField(
        "Categoría",
        coerce=int,
        validators=[
            DataRequired(
                message="Seleccione una categoría."
            )
        ]
    )

    proveedor_id = SelectField(
        "Proveedor",
        coerce=int,
        validators=[
            DataRequired(
                message="Seleccione un proveedor."
            )
        ]
    )

    submit = SubmitField(
        "Guardar producto"
    )




